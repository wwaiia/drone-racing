# Скопируйте в .env и заполните.

# БД: локально SQLite по умолчанию; при деплое переключить на PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/drone_events
DATABASE_URL=

ADMIN_TOKEN=change-me-admin-token

VK_SERVICE_TOKEN=

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=drone_aggregator
TELEGRAM_PROXY=

# Автономный сбор по крону (cron-job.org / Render Job):
# публичные каналы t.me (можно БЕЗ API-ключей — веб-коллектор t.me/s/<канал>):
COLLECT_CHANNELS=fpv_league,fgdr_events
# группы VK (works only when VK_SERVICE_TOKEN is set):
COLLECT_VK_GROUPS=
COLLECT_LIMIT=40

LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
